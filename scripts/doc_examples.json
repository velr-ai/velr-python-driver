    "QUERY_LANGUAGE.md#clauses-and-expressions:1": {
      "language": "cypher",
      "kind": "run",
      "setup": [
        "CREATE (:Person {name: 'Alice'})"
      ],
      "verify_queries": [
        "MATCH (:Person {name: 'Alice'})-[:INTERESTED_IN]->(t:Topic) RETURN t.name AS topic ORDER BY topic"
      ],
      "checks": [
        {
          "kind": "output",
          "match": [
            [
              {
                "p.name": "Alice"
              }
            ]
          ]
        },
        {
          "kind": "output",
          "match": [
